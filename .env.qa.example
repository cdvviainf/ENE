# ============================================================
# Variables para el QA en Coolify
# Copiar como referencia — configurar en la UI de Coolify,
# NO subir este archivo con valores reales al repositorio.
# ============================================================

# ── Base de datos ────────────────────────────────────────────
DB_USER=ene_user
DB_PASSWORD=CAMBIAR_password_seguro
DB_NAME=ene_db

# ── Redis (envío de correo — cola, ver docker-compose.qa.yml) ─
REDIS_PASSWORD=CAMBIAR_redis_password_seguro

# ── Auth (Better Auth) ───────────────────────────────────────
# Mínimo 32 caracteres — generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=CAMBIAR_minimo_32_caracteres_xxxxxxxxxxxxxxxx

# ── URLs públicas ────────────────────────────────────────────
# Asignar los subdominios reales configurados en Coolify
API_PUBLIC_URL=https://api-ene-qa.tudominio.cl
WEB_PUBLIC_URL=https://ene-qa.tudominio.cl

# ── Build args para Next.js (se embeben en el bundle) ────────
# Debe coincidir con API_PUBLIC_URL + /api
NEXT_PUBLIC_API_URL=https://api-ene-qa.tudominio.cl/api

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_xxxx
MAIL_FROM="Extremo Norte <no-reply@extremonorte.com>"

# ── DTE — facturación electrónica ────────────────────────────
DTE_PROVIDER=mock
# DTE_PROVIDER=chilesystems
# DTE_API_URL=
# DTE_API_KEY=
# DTE_RUT_EMISOR=
# DTE_AMBIENTE=certificacion

# ── Moneda — TC de referencia para OT abiertas ───────────────
TC_REFERENCIA_USD=950
