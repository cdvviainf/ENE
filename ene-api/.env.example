# App
NODE_ENV=development
PORT=3011
TZ=America/Santiago

# Database
DATABASE_URL=postgresql://ene_user:ene_pass@localhost:5434/ene_db

# Auth (Better Auth)
BETTER_AUTH_SECRET=cambiar_por_secreto_de_32_caracteres_minimo
BETTER_AUTH_URL=http://localhost:3011

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM="Extremo Norte <no-reply@extremonorte.com>"

# DTE — facturación electrónica
DTE_PROVIDER=mock            # mock | chilesystems | simplefactura
DTE_API_URL=
DTE_API_KEY=
DTE_RUT_EMISOR=
DTE_AMBIENTE=certificacion   # certificacion | produccion

# Motor de documentos (Playwright)
PDF_BROWSER_WS=

# Adjuntos
ADJUNTOS_PATH=/data/adjuntos
ADJUNTOS_MAX_MB=25

# Moneda — TC de referencia para OT abiertas
TC_REFERENCIA_USD=950

# CORS
CORS_ORIGIN=http://localhost:3010
