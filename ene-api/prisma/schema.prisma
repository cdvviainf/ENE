// ============================================================================
// ENE — Sistema de Gestión de Operaciones · Extremo Norte Expediciones
// Convenciones canónicas (CLAUDE.md §0 y §5):
//   · id Int autoincrement en todas las tablas; `codigo` para identificación humana
//   · naming de dominio en español
//   · auditoría creadoEn/creadoPor, actualizadoEn/actualizadoPor, eliminadoEn
//   · montos Decimal(18,4) · margen Decimal(7,4) · tipo de cambio Decimal(12,6)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum TipoCliente {
  AGENCIA
  EMPRESA
}

enum AreaNegocio {
  RECEPTIVO
  EVENTOS
}

enum Moneda {
  CLP
  USD
}

enum ModeloTarifa {
  TRAMO_PAX
  ACOMODACION
  UNITARIO_PAX
}

enum Acomodacion {
  SINGLE
  DOBLE
  TWIN
  TRIPLE
}

enum Bloque {
  AM
  PM
}

enum TipoLinea {
  ESTANDAR
  OTRO
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  EN_NEGOCIACION
  APROBADA
  PERDIDA
  DESISTIDA
}

enum EstadoOT {
  CONFIRMADA
  EN_ESPERA
  EN_PREPARACION
  EN_OPERACION
  EJECUTADA
  CERRADA
  CANCELADA
  NO_SHOW
}

enum TipoCambioVersion {
  ALCANCE
  CORRECCION
}

enum EstadoServicio {
  PENDIENTE
  TENTATIVO
  CONFIRMADO
  RECHAZADO
  CANCELADO
}

enum EstadoOC {
  BORRADOR
  EMITIDA
  MODIFICADA
  ANULADA
}

enum TipoDTE {
  FACTURA_AFECTA
  FACTURA_EXENTA
  BOLETA
  NOTA_CREDITO
}

enum EstadoDTE {
  PENDIENTE
  EMITIDO
  RECHAZADO
  ANULADO
}

enum TipoMovimiento {
  ABONO
  FACTURA
  PAGO
  NOTA_CREDITO
  AJUSTE
}

enum TipoPagoProveedor {
  ABONO
  PAGO
}

enum EstadoFacturaProv {
  RECIBIDA
  VALIDADA
  PROGRAMADA
  PAGADA
  ANULADA
}

enum EntidadAdjunto {
  ORDEN_TRABAJO
  ORDEN_COMPRA
  COTIZACION
  FACTURA_PROVEEDOR
  PAGO_PROVEEDOR
}

enum NivelAcceso {
  SIN_ACCESO
  LECTURA
  TOTAL
}

// ─── Better Auth ────────────────────────────────────────────────────────────
// Tablas propias de Better Auth (identidad y credenciales). El dominio vive en
// `Usuario`, que se enlaza por `Usuario.authUserId → User.id` (CLAUDE.md §5:
// id Int en el dominio; el id de auth es string). No se editan a mano.

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  usuario  Usuario?

  @@map("auth_user")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  issuer                String?
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("auth_account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("auth_verification")
}

// ─── Usuarios y permisos ────────────────────────────────────────────────────

model Usuario {
  id             Int       @id @default(autoincrement())
  codigo         String    @unique
  authUserId     String?   @unique
  nombre         String
  email          String    @unique
  perfilId       Int
  activo         Boolean   @default(true)
  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  perfil   Perfil @relation(fields: [perfilId], references: [id])
  // RN-PER: enlace 1:1 con la identidad de Better Auth. Nullable: un Usuario
  // puede existir sin credencial todavía; sin authUserId no puede autenticarse.
  authUser User?  @relation(fields: [authUserId], references: [id])

  @@map("usuario")
}

model Perfil {
  id             Int       @id @default(autoincrement())
  codigo         String    @unique
  nombre         String
  descripcion    String?
  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  usuarios Usuario[]
  accesos  PerfilItemMenu[]

  @@map("perfil")
}

model ItemMenu {
  id       Int     @id @default(autoincrement())
  codigo   String  @unique
  nombre   String
  modulo   String
  ruta     String?
  esAccion Boolean @default(false)
  orden    Int     @default(0)
  activo   Boolean @default(true)

  perfiles PerfilItemMenu[]

  @@map("item_menu")
}

model PerfilItemMenu {
  id         Int         @id @default(autoincrement())
  perfilId   Int
  itemMenuId Int
  nivel      NivelAcceso @default(SIN_ACCESO)

  perfil   Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  itemMenu ItemMenu @relation(fields: [itemMenuId], references: [id], onDelete: Cascade)

  @@unique([perfilId, itemMenuId])
  @@map("perfil_item_menu")
}

// ─── Maestros ───────────────────────────────────────────────────────────────

model Cliente {
  id              Int         @id @default(autoincrement())
  codigo          String      @unique
  tipo            TipoCliente
  razonSocial     String
  rut             String?
  nombreComercial String?
  paisId          Int
  monedaHabitual  Moneda      @default(USD)
  formaPagoId     Int?
  condicionPagoId Int?
  email           String?
  telefono        String?
  creadoEn        DateTime    @default(now())
  creadoPor       String
  actualizadoEn   DateTime?   @updatedAt
  actualizadoPor  String?
  eliminadoEn     DateTime?
  eliminadoPor    String?

  pais          Pais           @relation(fields: [paisId], references: [id])
  formaPago     FormaPago?     @relation(fields: [formaPagoId], references: [id])
  condicionPago CondicionPago? @relation(fields: [condicionPagoId], references: [id])

  ejecutivos   ClienteEjecutivo[]
  direcciones  ClienteDireccion[]
  negocios     Negocio[]
  cotizaciones Cotizacion[]
  ordenes      OrdenTrabajo[]
  movimientos  MovimientoCuenta[]

  @@index([tipo])
  @@index([paisId])
  @@map("cliente")
}

/// RN-CLI-05 [BLOQUEA]: como máximo un ejecutivo por cliente con
/// esRepresentanteLegal=true — índice único parcial, ver comentario en
/// ClienteDireccion (RN-GEO-03) y migración `contactos_representante_legal`.
model ClienteEjecutivo {
  id                   Int       @id @default(autoincrement())
  clienteId            Int
  nombre               String
  email                String?
  telefono             String?
  cargo                String?
  descripcion          String?
  esRepresentanteLegal Boolean   @default(false)
  activo               Boolean   @default(true)
  creadoEn             DateTime  @default(now())
  creadoPor            String
  actualizadoEn        DateTime? @updatedAt
  actualizadoPor       String?
  eliminadoEn          DateTime?
  eliminadoPor         String?

  cliente      Cliente        @relation(fields: [clienteId], references: [id])
  cotizaciones Cotizacion[]
  ordenes      OrdenTrabajo[]

  @@index([clienteId])
  @@map("cliente_ejecutivo")
}

/// Dirección del cliente (RN-GEO-02): `comunaId` es obligatorio solo si el
/// país elegido es Chile (`Pais.esPaisNacional`), validado en el service.
/// RN-GEO-03: como máximo una dirección por cliente con `esPorDefecto=true`,
/// garantizado por un índice único parcial fuera de este schema (Prisma no
/// expresa índices parciales) — ver migración
/// `direccion_default_unico_parcial`.
model ClienteDireccion {
  id             Int       @id @default(autoincrement())
  clienteId      Int
  etiqueta       String
  descripcion    String?
  paisId         Int
  comunaId       Int?
  direccion      String
  esPorDefecto   Boolean   @default(false)
  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  cliente Cliente @relation(fields: [clienteId], references: [id])
  pais    Pais    @relation(fields: [paisId], references: [id])
  comuna  Comuna? @relation(fields: [comunaId], references: [id])

  @@index([clienteId])
  @@map("cliente_direccion")
}

/// Negocio (antes "Grupo"): los pasajeros que viajan. `apellido` es el
/// identificador operativo de la reserva y es obligatorio en la OT (CLAUDE.md
/// §7). No confundir con `areaNegocio` (RECEPTIVO/EVENTOS), que es otro atributo.
model Negocio {
  id             Int       @id @default(autoincrement())
  codigo         String    @unique
  apellido       String
  // RN-NEG-05 (ex RN-GRP-05): el cliente es opcional — solo código y apellido
  // son obligatorios.
  clienteId      Int?
  nacionalidad   String?
  paisOrigen     String?
  idioma         String?
  cantidadPax    Int       @default(1)
  observaciones  String?
  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  cliente      Cliente?       @relation(fields: [clienteId], references: [id])
  pasajeros    Pasajero[]
  cotizaciones Cotizacion[]
  ordenes      OrdenTrabajo[]

  @@index([apellido])
  @@index([clienteId])
  @@map("negocio")
}

model Pasajero {
  id             Int       @id @default(autoincrement())
  negocioId      Int
  nombre         String
  edad           Int?
  nacionalidad   String?
  documento      String?
  restricciones  String?
  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  negocio Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@index([negocioId])
  @@map("pasajero")
}

model Zona {
  id             Int       @id @default(autoincrement())
  codigo         String    @unique
  nombre         String
  nombreEn       String?
  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  servicios    Servicio[]
  proveedores  ProveedorZona[]
  cotizaciones CotizacionZona[]
  ordenes      OrdenTrabajoZona[]

  @@map("zona")
}

model TipoServicio {
  id                  Int          @id @default(autoincrement())
  codigo              String       @unique
  nombre              String
  modeloTarifaDefault ModeloTarifa
  ventanaAvisoDias    Int          @default(30)
  creadoEn            DateTime     @default(now())
  creadoPor           String
  actualizadoEn       DateTime?    @updatedAt
  actualizadoPor      String?
  eliminadoEn         DateTime?
  eliminadoPor        String?

  servicios   Servicio[]
  proveedores ProveedorTipoServicio[]

  @@map("tipo_servicio")
}

/// Forma de pago (Efectivo USD, Transferencia CLP, Tarjeta de crédito...).
/// Catálogo único compartido entre Cliente y Proveedor (RN-PAG-01).
model FormaPago {
  id                  Int       @id @default(autoincrement())
  codigo              String    @unique
  nombre              String
  // RN-COS-08: recargo operacional de la forma de pago (0.03 = 3% tarjeta de
  // crédito). Se suma a la propuesta como pass-through sobre la venta.
  porcentajeAdicional Decimal   @default(0) @db.Decimal(7, 4)
  creadoEn            DateTime  @default(now())
  creadoPor           String
  actualizadoEn       DateTime? @updatedAt
  actualizadoPor      String?
  eliminadoEn         DateTime?
  eliminadoPor        String?

  clientes            Cliente[]
  proveedores         Proveedor[]
  versionesCotizacion CotizacionVersion[]

  @@map("forma_pago")
}

/// Condición de pago (Contado, 30 días, 50% anticipo...). Catálogo único
/// compartido entre Cliente y Proveedor (RN-PAG-01), con cronograma de cuotas
/// (RN-PAG-02: la suma de porcentajes de las cuotas debe ser 100%).
model CondicionPago {
  id             Int       @id @default(autoincrement())
  codigo         String    @unique
  nombre         String
  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  cuotas      CondicionPagoCuota[]
  clientes    Cliente[]
  proveedores Proveedor[]

  @@map("condicion_pago")
}

model CondicionPagoCuota {
  id              Int     @id @default(autoincrement())
  condicionPagoId Int
  numeroCuota     Int
  porcentaje      Decimal @db.Decimal(5, 2)
  plazoDias       Int

  condicionPago CondicionPago @relation(fields: [condicionPagoId], references: [id], onDelete: Cascade)

  @@index([condicionPagoId])
  @@map("condicion_pago_cuota")
}

/// RN-PRV-11: mantenedor de tipos de documento que un proveedor emite a ENE.
/// Reemplaza el enum `TipoDocProveedor`. Incluye "A nada" (NINGUNO) y "Boleta de
/// honorarios a tercero" (RETENCION). `porcentaje` + `formaCalculo` dan la
/// retención/IVA referencial (interno, no afecta el presupuesto ni el PDF).
model TipoDocumento {
  id             Int                  @id @default(autoincrement())
  codigo         String               @unique
  nombre         String
  formaCalculo   FormaCalculoImpuesto @default(NINGUNO)
  porcentaje     Decimal              @default(0) @db.Decimal(7, 4)
  creadoEn       DateTime             @default(now())
  creadoPor      String
  actualizadoEn  DateTime?            @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  proveedores Proveedor[]

  @@map("tipo_documento")
}

/// RN-EMP-01: datos de la empresa emisora (ENE). Singleton (una sola fila,
/// id=1). El logo se guarda en el filesystem (`logoStorageKey`) y el PDF lo
/// incrusta como data URI. Reemplaza el `EMISOR` hardcodeado del resolver.
model Empresa {
  id             Int       @id @default(autoincrement())
  nombre         String
  rut            String?
  direccion      String?
  email          String?
  web            String?
  telefono       String?
  logoStorageKey String?
  logoMimeType   String?
  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?

  @@map("empresa")
}

/// Jerarquía geográfica para Direcciones (RN-GEO-01). `Region` no lleva FK a
/// `Pais`: la cadena Region→Provincia→Comuna es implícitamente solo de Chile
/// (mismo modelo que FAS, que solo siembra geografía chilena); `Pais` es una
/// lista plana aparte, con `esPaisNacional` marcando la fila Chile.
model Pais {
  id             Int       @id @default(autoincrement())
  codigo         String    @unique
  nombre         String
  esPaisNacional Boolean   @default(false)
  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  clientes             Cliente[]
  direccionesCliente   ClienteDireccion[]
  direccionesProveedor ProveedorDireccion[]

  @@map("pais")
}

model Region {
  id             Int       @id @default(autoincrement())
  codigo         String    @unique
  nombre         String
  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  provincias Provincia[]

  @@map("region")
}

model Provincia {
  id             Int       @id @default(autoincrement())
  codigo         String    @unique
  nombre         String
  regionId       Int
  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  region  Region   @relation(fields: [regionId], references: [id])
  comunas Comuna[]

  @@index([regionId])
  @@map("provincia")
}

model Comuna {
  id             Int       @id @default(autoincrement())
  codigo         String    @unique
  nombre         String
  provinciaId    Int
  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  provincia            Provincia            @relation(fields: [provinciaId], references: [id])
  direccionesCliente   ClienteDireccion[]
  direccionesProveedor ProveedorDireccion[]

  @@index([provinciaId])
  @@map("comuna")
}

/// `rut` es obligatorio y único (RN-PRV-01): es la llave para cotejar
/// facturas. Un proveedor extranjero sin RUT chileno real usa el RUT genérico
/// 55.555.555-5 (definición del cliente, 27-ago-2026) — sigue siendo un RUT
/// válido, no hay excepción que modelar. Como ese valor genérico se repite
/// entre proveedores distintos, la unicidad real NO se declara acá con
/// `@unique`: se aplica con un índice único parcial en la migración SQL
/// (`WHERE rut <> '55.555.555-5'`), documentado en CLAUDE.md §7.
/// RN-PRV-11: forma de cálculo del impuesto/retención referencial asociado al
/// tipo de documento que el proveedor emite a ENE. IVA se suma sobre el costo,
/// RETENCION se descuenta, NINGUNO no aplica. Es referencial (no afecta el
/// presupuesto); el monto efectivo es Etapa 10.
enum FormaCalculoImpuesto {
  NINGUNO
  IVA
  RETENCION
}

model Proveedor {
  id                  Int       @id @default(autoincrement())
  codigo              String    @unique
  razonSocial         String
  rut                 String
  nombreComercial     String?
  // RN-PRV-09/11: tipo de documento que emite (ahora mantenedor, no enum).
  tipoDocumentoId     Int?
  // RN-PRV-10: link de pago del proveedor (URL a portal de pago o transferencia).
  urlPago             String?
  formaPagoId         Int?
  condicionPagoId     Int?
  politicaCancelacion String?
  email               String?
  telefono            String?
  creadoEn            DateTime  @default(now())
  creadoPor           String
  actualizadoEn       DateTime? @updatedAt
  actualizadoPor      String?
  eliminadoEn         DateTime?
  eliminadoPor        String?

  formaPago     FormaPago?     @relation(fields: [formaPagoId], references: [id])
  condicionPago CondicionPago? @relation(fields: [condicionPagoId], references: [id])
  tipoDocumento TipoDocumento? @relation(fields: [tipoDocumentoId], references: [id])

  // RN-PRV-08: un proveedor puede pertenecer a varios tipos de servicio a la
  // vez (mismo criterio que zonas, RN-PRV-05) — N:N en vez de FK único.
  tiposServicio    ProveedorTipoServicio[]
  zonas            ProveedorZona[]
  alias            ProveedorAlias[]
  cuentas          ProveedorCuenta[]
  contactos        ProveedorContacto[]
  direcciones      ProveedorDireccion[]
  tarifarios       Tarifario[]
  ordenes          OrdenCompra[]
  facturas         FacturaProveedor[]
  pagos            PagoProveedor[]
  lineasCotizacion CotizacionLinea[]
  lineasOT         OrdenTrabajoLinea[]

  @@index([razonSocial])
  @@map("proveedor")
}

/// RN-PRV-08: un proveedor puede pertenecer a varios tipos de servicio a la
/// vez. Antes era `Proveedor.tipoServicioId` único; mismo criterio y mismo
/// riesgo de migrar después que ya justificó ProveedorZona.
model ProveedorTipoServicio {
  proveedorId    Int
  tipoServicioId Int

  proveedor    Proveedor    @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  tipoServicio TipoServicio @relation(fields: [tipoServicioId], references: [id])

  @@id([proveedorId, tipoServicioId])
  @@map("proveedor_tipo_servicio")
}

/// Un proveedor puede operar en varias zonas a la vez (definición del
/// cliente, 27-ago-2026). Antes era `Proveedor.zonaId` único; se modela como
/// N:N porque cambiar esto después de cargada la data sería más costoso.
model ProveedorZona {
  proveedorId Int
  zonaId      Int

  proveedor Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  zona      Zona      @relation(fields: [zonaId], references: [id])

  @@id([proveedorId, zonaId])
  @@map("proveedor_zona")
}

/// Nombre interno o glosa bancaria distinta de la razón social. Sin esto la
/// identificación de un cargo o una factura es manual (levantamiento Lorena).
/// Subtabla de detalle operativo sin referencias externas: borrado físico
/// (DELETE real), con auditoría de creación para trazabilidad básica.
model ProveedorAlias {
  id           Int       @id @default(autoincrement())
  proveedorId  Int
  alias        String
  creadoEn     DateTime  @default(now())
  creadoPor    String
  eliminadoEn  DateTime?
  eliminadoPor String?

  proveedor Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@index([alias])
  @@map("proveedor_alias")
}

model ProveedorCuenta {
  id             Int       @id @default(autoincrement())
  proveedorId    Int
  banco          String
  tipoCuenta     String?
  numeroCuenta   String
  titular        String?
  rutTitular     String?
  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  proveedor Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@map("proveedor_cuenta")
}

/// RN-PRV-06 [BLOQUEA]: como máximo un contacto por proveedor con
/// esRepresentanteLegal=true — mismo criterio que RN-CLI-05. RN-PRV-07:
/// esEjecutivo no es exclusivo, marca contactos seleccionables luego en OT
/// (Etapa 8, todavía no construida).
model ProveedorContacto {
  id                   Int       @id @default(autoincrement())
  proveedorId          Int
  nombre               String
  email                String?
  telefono             String?
  cargo                String?
  descripcion          String?
  esRepresentanteLegal Boolean   @default(false)
  esEjecutivo          Boolean   @default(false)
  creadoEn             DateTime  @default(now())
  creadoPor            String
  actualizadoEn        DateTime? @updatedAt
  actualizadoPor       String?
  eliminadoEn          DateTime?
  eliminadoPor         String?

  proveedor Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@map("proveedor_contacto")
}

/// Dirección del proveedor (RN-GEO-02): mismo criterio que ClienteDireccion.
/// RN-GEO-03: índice único parcial, ver comentario en ClienteDireccion.
model ProveedorDireccion {
  id             Int       @id @default(autoincrement())
  proveedorId    Int
  etiqueta       String
  descripcion    String?
  paisId         Int
  comunaId       Int?
  direccion      String
  esPorDefecto   Boolean   @default(false)
  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  proveedor Proveedor @relation(fields: [proveedorId], references: [id])
  pais      Pais      @relation(fields: [paisId], references: [id])
  comuna    Comuna?   @relation(fields: [comunaId], references: [id])

  @@index([proveedorId])
  @@map("proveedor_direccion")
}

model Servicio {
  id             Int          @id @default(autoincrement())
  codigo         String       @unique
  nombre         String
  nombreEn       String?
  descripcion    String?
  descripcionEn  String?
  zonaId         Int?
  tipoServicioId Int
  modeloTarifa   ModeloTarifa
  margenSugerido Decimal      @default(0) @db.Decimal(7, 4)
  duracionDias   Int?
  creadoEn       DateTime     @default(now())
  creadoPor      String
  actualizadoEn  DateTime?    @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  zona         Zona?        @relation(fields: [zonaId], references: [id])
  tipoServicio TipoServicio @relation(fields: [tipoServicioId], references: [id])

  tarifarios       Tarifario[]
  lineasCotizacion CotizacionLinea[]
  lineasOT         OrdenTrabajoLinea[]

  @@map("servicio")
}

// ─── Tarifas ────────────────────────────────────────────────────────────────

model Tarifario {
  id            Int       @id @default(autoincrement())
  proveedorId   Int
  servicioId    Int
  moneda        Moneda
  vigenciaDesde DateTime
  vigenciaHasta DateTime?
  version       Int       @default(1)
  activo        Boolean   @default(true)
  creadoEn      DateTime  @default(now())
  creadoPor     String
  eliminadoEn   DateTime?
  eliminadoPor  String?

  proveedor Proveedor        @relation(fields: [proveedorId], references: [id])
  servicio  Servicio         @relation(fields: [servicioId], references: [id])
  valores   TarifarioValor[]

  @@index([servicioId, vigenciaDesde])
  @@map("tarifario")
}

/// Los tres modelos de tarifa conviven acá con discriminador y campos nulables.
/// TRAMO_PAX     → valor del servicio completo para el rango [paxDesde, paxHasta]
/// ACOMODACION   → valor por habitación según ocupación; suplementoSingle es
///                 valor propio, no derivado
/// UNITARIO_PAX  → valor por pasajero, se multiplica por la cantidad
model TarifarioValor {
  id               Int          @id @default(autoincrement())
  tarifarioId      Int
  modelo           ModeloTarifa
  paxDesde         Int?
  paxHasta         Int?
  acomodacion      Acomodacion?
  valor            Decimal      @db.Decimal(18, 4)
  suplementoSingle Decimal?     @db.Decimal(18, 4)

  tarifario        Tarifario         @relation(fields: [tarifarioId], references: [id], onDelete: Cascade)
  lineasCotizacion CotizacionLinea[]

  @@index([tarifarioId])
  @@map("tarifario_valor")
}

// ─── Cotización ─────────────────────────────────────────────────────────────

model Cotizacion {
  id               Int              @id @default(autoincrement())
  numero           String           @unique
  clienteId        Int
  ejecutivoId      Int?
  negocioId        Int
  areaNegocio      AreaNegocio
  fechaOperacion   DateTime
  cantidadPax      Int
  idiomaDocumento  String           @default("es")
  moneda           Moneda
  tipoCambio       Decimal          @db.Decimal(12, 6)
  estado           EstadoCotizacion @default(BORRADOR)
  versionVigenteId Int?             @unique
  creadoEn         DateTime         @default(now())
  creadoPor        String
  actualizadoEn    DateTime?        @updatedAt
  actualizadoPor   String?
  eliminadoEn      DateTime?
  eliminadoPor     String?

  cliente   Cliente           @relation(fields: [clienteId], references: [id])
  ejecutivo ClienteEjecutivo? @relation(fields: [ejecutivoId], references: [id])
  negocio   Negocio           @relation(fields: [negocioId], references: [id])
  zonas     CotizacionZona[]

  versiones      CotizacionVersion[] @relation("CotizacionVersiones")
  // RN-VER-05: la vigente se referencia por [versionVigenteId, id] contra
  // [id, cotizacionId] de la versión, para que nunca sea de otra cabecera.
  versionVigente CotizacionVersion?  @relation("CotizacionVigente", fields: [versionVigenteId, id], references: [id, cotizacionId], onDelete: NoAction, onUpdate: NoAction)
  // La OT es dueña de la FK (RN-OT-01): OrdenTrabajo.cotizacionId, obligatorio.
  ordenTrabajo   OrdenTrabajo?

  // RN-VER-05: lado definidor 1-1 de la FK compuesta de versión vigente.
  @@unique([versionVigenteId, id])
  @@index([estado])
  @@index([fechaOperacion])
  @@map("cotizacion")
}

model CotizacionVersion {
  id                 Int       @id @default(autoincrement())
  cotizacionId       Int
  version            Int
  motivo             String?
  costoTotal         Decimal   @db.Decimal(18, 4)
  margenTotal        Decimal   @db.Decimal(18, 4)
  // RN-COS-04: suma de las líneas valorizadas, SIN el recargo de forma de pago.
  ventaTotal         Decimal   @db.Decimal(18, 4)
  // RN-COT-09: vigencia de la oferta (hasta cuándo es válida esta versión).
  fechaVigencia      DateTime?
  // RN-COT-10: comentarios de encabezado del documento (bilingües).
  incluidos          String?
  incluidosEn        String?
  noIncluidos        String?
  noIncluidosEn      String?
  notasImportantes   String?
  notasImportantesEn String?
  // RN-COS-08: forma de pago elegida + recargo pass-through congelado. El % se
  // snapshotea desde FormaPago.porcentajeAdicional al guardar; recargoTotal =
  // ventaTotal × recargoPct. El total con recargo se deriva (ventaTotal+recargo).
  formaPagoId        Int?
  recargoPct         Decimal   @default(0) @db.Decimal(7, 4)
  recargoTotal       Decimal   @default(0) @db.Decimal(18, 4)
  creadoEn           DateTime  @default(now())
  creadoPor          String

  cotizacion Cotizacion        @relation("CotizacionVersiones", fields: [cotizacionId], references: [id], onDelete: Restrict)
  vigenteDe  Cotizacion?       @relation("CotizacionVigente")
  formaPago  FormaPago?        @relation(fields: [formaPagoId], references: [id])
  lineas     CotizacionLinea[]

  @@unique([cotizacionId, version])
  @@unique([id, cotizacionId])
  @@map("cotizacion_version")
}

/// RN-COT-08: una cotización puede abarcar varias zonas (N:N). Tabla puente pura
/// con PK compuesta (mismo criterio que ProveedorZona).
model CotizacionZona {
  cotizacionId Int
  zonaId       Int

  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  zona       Zona       @relation(fields: [zonaId], references: [id])

  @@id([cotizacionId, zonaId])
  @@index([zonaId])
  @@map("cotizacion_zona")
}

model CotizacionLinea {
  id                  Int          @id @default(autoincrement())
  cotizacionVersionId Int
  dia                 Int
  bloque              Bloque
  orden               Int          @default(0)
  tipoLinea           TipoLinea
  servicioId          Int?
  proveedorId         Int?
  tarifarioValorId    Int?
  descripcion         String
  descripcionEn       String?
  // RN-COT-10: observación libre por línea (bilingüe), sale en el PDF.
  observacion         String?
  observacionEn       String?
  cantidadPax         Int
  acomodacion         Acomodacion?
  costoUnitario       Decimal      @db.Decimal(18, 4)
  costoTotal          Decimal      @db.Decimal(18, 4)
  margenPct           Decimal      @db.Decimal(7, 4)
  ventaTotal          Decimal      @db.Decimal(18, 4)
  // RN-COS-06 [BLOQUEA]: la base tarifaria usada al capturar la línea ESTANDAR
  // (modelo + tramos/valor/valores de acomodación + moneda) se congela acá. El
  // recálculo por pax (RN-COS-07) se hace SIEMPRE contra este snapshot, nunca
  // re-resolviendo el maestro, para que una modificación posterior del
  // tarifario no altere una cotización ya cargada. null en líneas OTRO.
  tarifarioSnapshot   Json?

  version        CotizacionVersion @relation(fields: [cotizacionVersionId], references: [id], onDelete: Restrict)
  servicio       Servicio?         @relation(fields: [servicioId], references: [id])
  proveedor      Proveedor?        @relation(fields: [proveedorId], references: [id])
  tarifarioValor TarifarioValor?   @relation(fields: [tarifarioValorId], references: [id])

  @@index([cotizacionVersionId])
  @@map("cotizacion_linea")
}

// ─── Orden de Trabajo ───────────────────────────────────────────────────────

/// La cotización aprobada genera la OT copiando sus líneas. La versión 1 es la
/// línea base congelada y es contra la que se compara el costo real.
model OrdenTrabajo {
  id                   Int         @id @default(autoincrement())
  numero               String      @unique
  cotizacionId         Int         @unique
  clienteId            Int
  ejecutivoId          Int?
  negocioId            Int
  apellido             String
  areaNegocio          AreaNegocio
  fechaOperacion       DateTime
  cantidadPax          Int
  moneda               Moneda
  tipoCambioCotizacion Decimal     @db.Decimal(12, 6)
  estado               EstadoOT    @default(CONFIRMADA)
  versionVigenteId     Int?        @unique
  creadoEn             DateTime    @default(now())
  creadoPor            String
  actualizadoEn        DateTime?   @updatedAt
  actualizadoPor       String?
  eliminadoEn          DateTime?
  eliminadoPor         String?

  cliente    Cliente            @relation(fields: [clienteId], references: [id])
  ejecutivo  ClienteEjecutivo?  @relation(fields: [ejecutivoId], references: [id])
  negocio    Negocio            @relation(fields: [negocioId], references: [id])
  zonas      OrdenTrabajoZona[]
  // RN-OT-01: la OT nace de una cotización aprobada; cotizacionId es obligatorio.
  cotizacion Cotizacion         @relation(fields: [cotizacionId], references: [id])

  versiones      OrdenTrabajoVersion[] @relation("OTVersiones")
  // RN-VER-05: la vigente pertenece a esta OT (par [versionVigenteId, id]).
  versionVigente OrdenTrabajoVersion?  @relation("OTVigente", fields: [versionVigenteId, id], references: [id, ordenTrabajoId], onDelete: NoAction, onUpdate: NoAction)
  ordenesCompra  OrdenCompra[]
  documentos     DocumentoTributario[]
  movimientos    MovimientoCuenta[]

  // RN-VER-05: lado definidor 1-1 de la FK compuesta de versión vigente.
  @@unique([versionVigenteId, id])
  @@index([estado, fechaOperacion])
  @@index([apellido])
  @@map("orden_trabajo")
}

/// RN-COT-08: la OT hereda las zonas de su cotización (N:N). Tabla puente pura.
model OrdenTrabajoZona {
  ordenTrabajoId Int
  zonaId         Int

  ordenTrabajo OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id], onDelete: Cascade)
  zona         Zona         @relation(fields: [zonaId], references: [id])

  @@id([ordenTrabajoId, zonaId])
  @@index([zonaId])
  @@map("orden_trabajo_zona")
}

model OrdenTrabajoVersion {
  id                Int               @id @default(autoincrement())
  ordenTrabajoId    Int
  version           Int
  tipoCambio        TipoCambioVersion @default(ALCANCE)
  motivo            String?
  costoTeoricoTotal Decimal           @db.Decimal(18, 4)
  margenTotal       Decimal           @db.Decimal(18, 4)
  ventaTotal        Decimal           @db.Decimal(18, 4)
  creadoEn          DateTime          @default(now())
  creadoPor         String

  // RN-VER-03: el historial nunca se borra; Restrict impide arrastrar versiones.
  ordenTrabajo  OrdenTrabajo         @relation("OTVersiones", fields: [ordenTrabajoId], references: [id], onDelete: Restrict)
  vigenteDe     OrdenTrabajo?        @relation("OTVigente")
  lineas        OrdenTrabajoLinea[]
  ordenesCompra OrdenCompraVersion[]

  @@unique([ordenTrabajoId, version])
  // RN-VER-05: par [id, ordenTrabajoId] referenciado por OrdenTrabajo.versionVigente.
  @@unique([id, ordenTrabajoId])
  @@map("orden_trabajo_version")
}

model OrdenTrabajoLinea {
  id                    Int            @id @default(autoincrement())
  ordenTrabajoVersionId Int
  dia                   Int
  bloque                Bloque
  orden                 Int            @default(0)
  tipoLinea             TipoLinea
  servicioId            Int?
  proveedorId           Int?
  descripcion           String
  descripcionEn         String?
  cantidadPax           Int
  acomodacion           Acomodacion?
  costoTeorico          Decimal        @db.Decimal(18, 4)
  margenPct             Decimal        @db.Decimal(7, 4)
  ventaLinea            Decimal        @db.Decimal(18, 4)
  estadoServicio        EstadoServicio @default(PENDIENTE)
  fechaServicio         DateTime?

  // RN-VER-03: las líneas de una versión son historial; no se cascadean.
  version   OrdenTrabajoVersion @relation(fields: [ordenTrabajoVersionId], references: [id], onDelete: Restrict)
  servicio  Servicio?           @relation(fields: [servicioId], references: [id])
  proveedor Proveedor?          @relation(fields: [proveedorId], references: [id])
  lineasOC  OrdenCompraLinea[]

  @@index([ordenTrabajoVersionId])
  @@map("orden_trabajo_linea")
}

// ─── Órdenes de compra ──────────────────────────────────────────────────────

model OrdenCompra {
  id               Int       @id @default(autoincrement())
  numero           String    @unique
  ordenTrabajoId   Int
  proveedorId      Int
  moneda           Moneda
  estado           EstadoOC  @default(BORRADOR)
  versionVigenteId Int?      @unique
  fechaEmision     DateTime?
  creadoEn         DateTime  @default(now())
  creadoPor        String
  actualizadoEn    DateTime? @updatedAt
  actualizadoPor   String?
  eliminadoEn      DateTime?
  eliminadoPor     String?

  ordenTrabajo OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])
  proveedor    Proveedor    @relation(fields: [proveedorId], references: [id])

  versiones      OrdenCompraVersion[] @relation("OCVersiones")
  // RN-VER-05: la vigente pertenece a esta OC (par [versionVigenteId, id]).
  versionVigente OrdenCompraVersion?  @relation("OCVigente", fields: [versionVigenteId, id], references: [id, ordenCompraId], onDelete: NoAction, onUpdate: NoAction)
  facturas       FacturaProveedor[]
  pagos          PagoProveedor[]

  // RN-VER-05: lado definidor 1-1 de la FK compuesta de versión vigente.
  @@unique([versionVigenteId, id])
  @@index([ordenTrabajoId])
  @@map("orden_compra")
}

model OrdenCompraVersion {
  id                    Int      @id @default(autoincrement())
  ordenCompraId         Int
  version               Int
  ordenTrabajoVersionId Int
  motivo                String?
  montoTotal            Decimal  @db.Decimal(18, 4)
  creadoEn              DateTime @default(now())
  creadoPor             String

  // RN-VER-03: el historial nunca se borra; Restrict impide arrastrar versiones.
  ordenCompra         OrdenCompra         @relation("OCVersiones", fields: [ordenCompraId], references: [id], onDelete: Restrict)
  vigenteDe           OrdenCompra?        @relation("OCVigente")
  ordenTrabajoVersion OrdenTrabajoVersion @relation(fields: [ordenTrabajoVersionId], references: [id])
  lineas              OrdenCompraLinea[]

  @@unique([ordenCompraId, version])
  // RN-VER-05: par [id, ordenCompraId] referenciado por OrdenCompra.versionVigente.
  @@unique([id, ordenCompraId])
  @@map("orden_compra_version")
}

model OrdenCompraLinea {
  id                   Int       @id @default(autoincrement())
  ordenCompraVersionId Int
  ordenTrabajoLineaId  Int?
  descripcion          String
  fechaServicio        DateTime?
  cantidadPax          Int
  costoReal            Decimal   @db.Decimal(18, 4)
  // RN-DIN-05: todo monto viaja con su moneda; se hereda de la cabecera de OC.
  moneda               Moneda

  // RN-VER-03: las líneas de una versión son historial; no se cascadean.
  version           OrdenCompraVersion @relation(fields: [ordenCompraVersionId], references: [id], onDelete: Restrict)
  ordenTrabajoLinea OrdenTrabajoLinea? @relation(fields: [ordenTrabajoLineaId], references: [id])

  @@index([ordenCompraVersionId])
  @@map("orden_compra_linea")
}

// ─── Facturación y cobros ───────────────────────────────────────────────────

model DocumentoTributario {
  id                Int       @id @default(autoincrement())
  ordenTrabajoId    Int
  tipo              TipoDTE
  folio             String?
  fechaEmision      DateTime?
  moneda            Moneda
  neto              Decimal   @db.Decimal(18, 4)
  iva               Decimal   @db.Decimal(18, 4)
  total             Decimal   @db.Decimal(18, 4)
  tipoCambioEmision Decimal   @db.Decimal(12, 6)
  estadoDte         EstadoDTE @default(PENDIENTE)
  proveedorDte      String?
  urlPdf            String?
  urlXml            String?
  respuestaJson     Json?
  creadoEn          DateTime  @default(now())
  creadoPor         String
  actualizadoEn     DateTime? @updatedAt
  actualizadoPor    String?
  eliminadoEn       DateTime?
  eliminadoPor      String?

  ordenTrabajo OrdenTrabajo       @relation(fields: [ordenTrabajoId], references: [id])
  movimientos  MovimientoCuenta[]

  @@index([ordenTrabajoId])
  @@map("documento_tributario")
}

/// Cuenta corriente del cliente. Un abono puede recibirse contra la OT sin que
/// exista factura. El saldo se calcula, no se almacena (vista rpt_).
model MovimientoCuenta {
  id                    Int            @id @default(autoincrement())
  clienteId             Int
  ordenTrabajoId        Int?
  documentoTributarioId Int?
  tipo                  TipoMovimiento
  fecha                 DateTime
  moneda                Moneda
  monto                 Decimal        @db.Decimal(18, 4)
  tipoCambio            Decimal        @db.Decimal(12, 6)
  montoClp              Decimal        @db.Decimal(18, 4)
  glosa                 String?
  referencia            String?
  creadoEn              DateTime       @default(now())
  creadoPor             String
  actualizadoEn         DateTime?      @updatedAt
  actualizadoPor        String?
  eliminadoEn           DateTime?
  eliminadoPor          String?

  cliente             Cliente              @relation(fields: [clienteId], references: [id])
  ordenTrabajo        OrdenTrabajo?        @relation(fields: [ordenTrabajoId], references: [id])
  documentoTributario DocumentoTributario? @relation(fields: [documentoTributarioId], references: [id])

  @@index([clienteId, fecha])
  @@map("movimiento_cuenta")
}

model FacturaProveedor {
  id             Int               @id @default(autoincrement())
  proveedorId    Int
  ordenCompraId  Int?
  numero         String
  fechaEmision   DateTime
  moneda         Moneda
  monto          Decimal           @db.Decimal(18, 4)
  adjuntoId      Int?
  estado         EstadoFacturaProv @default(RECIBIDA)
  observaciones  String?
  creadoEn       DateTime          @default(now())
  creadoPor      String
  actualizadoEn  DateTime?         @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  proveedor   Proveedor       @relation(fields: [proveedorId], references: [id])
  ordenCompra OrdenCompra?    @relation(fields: [ordenCompraId], references: [id])
  pagos       PagoProveedor[]

  @@index([proveedorId])
  @@map("factura_proveedor")
}

model PagoProveedor {
  id                   Int               @id @default(autoincrement())
  proveedorId          Int
  ordenCompraId        Int?
  facturaProveedorId   Int?
  tipo                 TipoPagoProveedor
  fecha                DateTime
  moneda               Moneda
  monto                Decimal           @db.Decimal(18, 4)
  tipoCambio           Decimal           @db.Decimal(12, 6)
  referencia           String?
  comprobanteAdjuntoId Int?
  creadoEn             DateTime          @default(now())
  creadoPor            String
  actualizadoEn        DateTime?         @updatedAt
  actualizadoPor       String?
  eliminadoEn          DateTime?
  eliminadoPor         String?

  proveedor        Proveedor         @relation(fields: [proveedorId], references: [id])
  ordenCompra      OrdenCompra?      @relation(fields: [ordenCompraId], references: [id])
  facturaProveedor FacturaProveedor? @relation(fields: [facturaProveedorId], references: [id])

  @@index([proveedorId, fecha])
  @@map("pago_proveedor")
}

// ─── Adjuntos ───────────────────────────────────────────────────────────────

model Adjunto {
  id            Int            @id @default(autoincrement())
  entidad       EntidadAdjunto
  entidadId     Int
  nombreArchivo String
  mimeType      String
  tamanoBytes   Int
  storageKey    String
  creadoEn      DateTime       @default(now())
  creadoPor     String
  eliminadoEn   DateTime?
  eliminadoPor  String?

  @@index([entidad, entidadId])
  @@map("adjunto")
}

// ─── Correlativos ───────────────────────────────────────────────────────────

/// Prefijo y cantidad de dígitos por tipo de documento. El siguiente número se
/// genera dentro de transacción con pg_advisory_xact_lock (CLAUDE.md §7).
model PrefijoCodigo {
  id             Int       @id @default(autoincrement())
  entidad        String    @unique
  prefijo        String
  digitos        Int       @default(4)
  incluyeAnio    Boolean   @default(true)
  ultimoValor    Int       @default(0)
  anio           Int?
  creadoEn       DateTime  @default(now())
  creadoPor      String
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?

  @@map("prefijo_codigo")
}
