# URL pública de ene-api (navegador)
NEXT_PUBLIC_API_URL=http://localhost:3011/api

# URL pública del propio frontend (usada por el cliente de Better Auth)
NEXT_PUBLIC_APP_URL=http://localhost:3010

# URL de ene-api alcanzable desde dentro del contenedor Next.js (Docker).
# Solo necesaria si el proxy de auth corre en un contenedor separado del API;
# si no se define, se deriva de NEXT_PUBLIC_API_URL.
# INTERNAL_API_URL=http://api:3011
